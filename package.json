{
  "name": "perp-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "oxlint src && node --experimental-strip-types scripts/check-surfaces.ts",
    "test": "npm run test:core && npm run test:e2e",
    "app": "npm run electron:package",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev": "scripts/dev-electron.sh",
    "electron:package": "scripts/package-electron.sh",
    "test:e2e": "npm run build && node --test-concurrency=1 --test tests/e2e/*.e2e.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "benchmark:chart": "npm run build && node scripts/chart-scroll-benchmark.mjs",
    "benchmark:instruments": "npm run build && node scripts/instrument-navigation-benchmark.mjs",
    "test:okx:1h": "node scripts/okx-live-1h.mjs",
    "typecheck": "tsc -b",
    "check:desktop": "node scripts/check-desktop.mjs",
    "test:core": "node --experimental-strip-types --test src/*.test.ts tests/core/*.test.mjs",
    "app:deliver": "node scripts/deliver-electron.mjs",
    "app:smoke": "node scripts/smoke-electron.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@duckdb/node-api": "1.5.6-r.1",
    "@shadcn/react": "0.3.1",
    "@streamdown/code": "2.0.0",
    "ai": "7.0.143",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "@base-ui/react": "1.9.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/parser": "8.0.7",
    "@babel/plugin-transform-runtime": "8.0.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "shadcn": "4.22.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.perpetualradar.desktop",
    "productName": "Perpetual Swap Suite",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "macos/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Perpetual Swap Suite"
    },
    "asarUnpack": [
      "node_modules/@duckdb/node-api/**"
    ]
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": "12.x"
  },
  "packageManager": "npm@12.2.0"
}
