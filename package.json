{
  "name": "perp-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "oxlint src && node --experimental-strip-types scripts/check-surfaces.ts && node scripts/check-operation-boundaries.mjs",
    "test": "node scripts/test-sandbox.mjs all",
    "app": "npm run electron:package",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev": "scripts/dev-electron.sh",
    "electron:package": "scripts/package-electron.sh",
    "test:e2e": "node scripts/test-sandbox.mjs e2e",
    "test:gpu": "node scripts/test-sandbox.mjs gpu",
    "test:gpu:metal": "node scripts/gpu/build-metal-provider.mjs --tests && PERPETUAL_SWAP_METAL_NATIVE_TESTS=1 node --test tests/core/metal-provider.test.mjs && node scripts/test-sandbox.mjs gpu --metal --require-gpu-hardware-timing",
    "test:foreground": "node scripts/test-sandbox.mjs foreground",
    "benchmark": "node scripts/test-sandbox.mjs command -- node --experimental-strip-types scripts/benchmark.ts",
    "benchmark:operations": "node scripts/operation-overhead.mjs",
    "benchmark:metal": "node scripts/gpu/build-metal-provider.mjs --tests && node scripts/metal-observer-overhead.mjs",
    "benchmark:chart": "npm run build && node scripts/test-sandbox.mjs command --desktop -- node scripts/chart-scroll-performance.mjs",
    "benchmark:chart:foreground": "node scripts/test-sandbox.mjs command --foreground -- node scripts/chart-scroll-benchmark.mjs",
    "benchmark:instruments": "npm run build && node scripts/test-sandbox.mjs command --desktop -- node scripts/instrument-navigation-benchmark.mjs",
    "benchmark:market:foreground": "node scripts/test-sandbox.mjs command --foreground -- node scripts/market-resource-benchmark.mjs",
    "test:okx:1h": "node scripts/test-sandbox.mjs command --allow-network -- node scripts/okx-live-1h.mjs",
    "test:okx:streams": "node scripts/test-sandbox.mjs command --allow-network -- node scripts/okx-live-streams.mjs",
    "typecheck": "tsc -b",
    "check:desktop": "node scripts/check-desktop.mjs",
    "test:core": "node scripts/test-sandbox.mjs core",
    "app:deliver": "node scripts/deliver-electron.mjs",
    "app:smoke": "node scripts/test-sandbox.mjs command -- node scripts/smoke-electron.mjs",
    "sandbox": "node scripts/test-sandbox.mjs",
    "operations:report": "node scripts/operation-report.mjs",
    "benchmark:startup": "node scripts/test-sandbox.mjs command -- node scripts/benchmark-startup.mjs",
    "test:okx:chart": "npm run build && node scripts/test-sandbox.mjs command --desktop --allow-network --scenario okx-live-chart --require-category network --require-category database --require-category cpu --require-category io --require-category ipc --require-role electron-main --require-role renderer --require-role market-backend --require-role market-reader --require-role market-writer --require-role prepared-chart -- node scripts/okx-live-chart.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@duckdb/node-api": "1.5.6-r.1",
    "@shadcn/react": "0.3.1",
    "@streamdown/code": "2.0.0",
    "ai": "7.0.143",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.0",
    "tw-animate-css": "1.4.0",
    "@base-ui/react": "1.9.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "shadcn": "4.22.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.perpetualradar.desktop",
    "productName": "Perpetual Swap Suite",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "macos/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Perpetual Swap Suite"
    },
    "asarUnpack": [
      "node_modules/@duckdb/node-api/**"
    ]
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": "12.x"
  },
  "packageManager": "npm@12.2.0"
}
