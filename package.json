{
  "name": "perp-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "scripts/dev-electron.sh",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "node scripts/build-renderer.mjs",
    "lint": "oxlint --deny-warnings src electron && node --experimental-strip-types scripts/check-surfaces.ts",
    "typecheck": "tsc -b",
    "check:desktop": "node scripts/check-desktop.mjs",
    "test": "node scripts/run-tests.mjs unit",
    "test:fuzz": "node scripts/run-tests.mjs fuzz",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "check": "npm run typecheck && npm run lint && npm run check:desktop && npm test && npm run test:fuzz",
    "check:changed": "npm run typecheck && npm run lint && npm run check:desktop && node scripts/run-tests.mjs changed",
    "app": "scripts/package-electron.sh",
    "app:deliver": "node scripts/deliver-electron.mjs",
    "app:smoke": "node scripts/smoke-electron.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.perpetualradar.desktop",
    "productName": "Perpetual Swap Suite",
    "files": [
      "dist/index.html",
      "dist/assets/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "macos/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Perpetual Swap Suite"
    }
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": "12.x"
  },
  "packageManager": "npm@12.2.0"
}
