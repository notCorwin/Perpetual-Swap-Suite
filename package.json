{
  "name": "perp-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "lint": "oxlint --deny-warnings src electron && node --experimental-strip-types scripts/check-surfaces.ts && node scripts/check-operation-boundaries.mjs",
    "test": "node scripts/test-sandbox.mjs functional",
    "test:all": "node scripts/test-sandbox.mjs all",
    "test:acceptance": "node scripts/test-acceptance.mjs",
    "test:soak": "node scripts/test-sandbox.mjs soak",
    "app": "npm run electron:package",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev": "scripts/dev-electron.sh",
    "electron:package": "scripts/package-electron.sh",
    "test:e2e": "node scripts/test-sandbox.mjs e2e",
    "test:gpu": "node scripts/test-sandbox.mjs gpu",
    "test:gpu:metal": "node scripts/gpu/run-metal.mjs test",
    "test:foreground": "node scripts/test-sandbox.mjs foreground",
    "benchmark": "node scripts/test-sandbox.mjs command -- node --experimental-strip-types scripts/benchmark.ts",
    "benchmark:operations": "node scripts/operation-overhead.mjs",
    "benchmark:metal": "node scripts/gpu/run-metal.mjs benchmark",
    "benchmark:chart": "node scripts/run-build-benchmark.mjs chart",
    "benchmark:chart:foreground": "node scripts/test-sandbox.mjs command --foreground -- node scripts/chart-scroll-benchmark.mjs",
    "benchmark:instruments": "node scripts/run-build-benchmark.mjs instruments",
    "benchmark:market:foreground": "node scripts/test-sandbox.mjs command --foreground -- node scripts/market-resource-benchmark.mjs",
    "test:okx:1h": "node scripts/test-sandbox.mjs command --allow-network -- node scripts/okx-live-1h.mjs",
    "test:okx:streams": "node scripts/test-sandbox.mjs command --allow-network -- node scripts/okx-live-streams.mjs",
    "typecheck": "tsc -b",
    "check:desktop": "node scripts/check-desktop.mjs",
    "test:core": "node scripts/test-sandbox.mjs core",
    "app:deliver": "node scripts/deliver-electron.mjs",
    "app:smoke": "node scripts/test-sandbox.mjs command -- node scripts/smoke-electron.mjs",
    "sandbox": "node scripts/test-sandbox.mjs",
    "operations:report": "node scripts/operation-report.mjs",
    "benchmark:startup": "node scripts/test-sandbox.mjs command -- node scripts/benchmark-startup.mjs",
    "test:okx:chart": "node scripts/run-build-benchmark.mjs okx"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.perpetualradar.desktop",
    "productName": "Perpetual Swap Suite",
    "files": [
      "dist/index.html",
      "dist/assets/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "macos/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Perpetual Swap Suite"
    }
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": "12.x"
  },
  "packageManager": "npm@12.2.0"
}
