{
  "name": "perp-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "oxlint src && node --experimental-strip-types scripts/check-surfaces.ts",
    "test": "npm run test:renderer && npm run test:e2e",
    "app": "npm run electron:package",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev": "scripts/dev-electron.sh",
    "electron:package": "scripts/package-electron.sh",
    "test:renderer": "node --experimental-strip-types --test src/*.test.ts",
    "test:e2e": "npm run build && node --test-concurrency=1 --test tests/e2e/*.e2e.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "benchmark:chart": "npm run build && node scripts/chart-scroll-benchmark.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@shadcn/react": "0.3.1",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "ai": "7.0.137",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.53.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "streamdown": "2.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/parser": "8.0.7",
    "@babel/plugin-transform-runtime": "8.0.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "oxlint": "1.87.0",
    "playwright": "^1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.perpetualradar.desktop",
    "productName": "Perpetual Swap Suite",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "macos/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Perpetual Swap Suite"
    },
    "asarUnpack": [
      "node_modules/@duckdb/node-api/**"
    ]
  }
}
